# Copy this file to .env and fill in your key.
# Without a key the demo still runs; AI answers fall back to scripted text.
ANTHROPIC_API_KEY=

# Optional settings
AI_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max  (low keeps tutor replies fast)
AI_EFFORT=low
# Effort for generating task content (explanations, changes, checks) from uploaded files
AI_GEN_EFFORT=medium
AI_MAX_TOKENS=4000
# Set to 1 to force scripted answers even when a key is present (e.g. for a controlled condition)
AI_DISABLED=0
# How many tasks each participant does (each starts with an upload or an example)
TASKS_PER_PARTICIPANT=3
# Set to 1 for formal study sessions: disables "upload your own code" so every participant
# gets the same fixed, difficulty-matched example tasks.
STUDY_MODE=0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
